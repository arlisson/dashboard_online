{
  "name": "dashboard-avance",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard Avance — monólito Express/EJS para Hostinger",
  "main": "src/server.js",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "node scripts/verify-deploy.js",
    "start": "node src/server.js",
    "migrate:deploy": "knex migrate:latest --knexfile knexfile.js",
    "migrate:status": "knex migrate:list --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "seed:reference": "knex seed:run --knexfile knexfile.js",
    "test": "node --test",
    "test:run": "node --test",
    "legacy:inspect": "node scripts/migrate-legacy-sqlite.js --inspect",
    "legacy:migrate": "node scripts/migrate-legacy-sqlite.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "luxon": "^3.7.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "better-sqlite3": "^12.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "overrides": { "uuid": "11.1.1" }
}
