<%
const brl = (value) => Number(value || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const decimal = (value) => Number(value || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const target = (value) => value == null ? 'Não definida' : brl(value);
const percent = (realized, goal) => goal ? Math.max(0, realized / Number(goal) * 100) : 0;
const goalState = (realized, goal) => goal == null || Number(goal) === 0 ? 'neutral' : realized >= goal ? 'success' : realized >= goal * .9 ? 'warning' : 'danger';
const morning = dashboard.data.shifts.morning || { records: 0, units: 0, revenue: 0, withDocRecords: 0, withoutDocRecords: 0, withDocRevenue: 0, withoutDocRevenue: 0 };
const afternoon = dashboard.data.shifts.afternoon || { records: 0, units: 0, revenue: 0, withDocRecords: 0, withoutDocRecords: 0, withDocRevenue: 0, withoutDocRevenue: 0 };
const leader = dashboard.data.ranking[0];
const operatorTotal = dashboard.data.operators.reduce((sum, item) => sum + item.revenue, 0) || 1;
const periodLabels = { today: 'Hoje', morning: 'Manhã de hoje', afternoon: 'Tarde de hoje', week: 'Semana atual', biweekly: 'Quinzena atual', month: 'Mês atual', custom: 'Personalizado' };
%>
<section class="sales-dashboard" aria-label="Dashboard de vendas">
  <section class="sales-dashboard__top" aria-label="Resumo de vendas">
    <% [[morning, 'Manhã', 'morning', '08:00 - 12:00', dashboard.target?.morning_value], [afternoon, 'Tarde', 'afternoon', '13:30 - 17:30', dashboard.target?.afternoon_value], [dashboard.data.totals, 'Total do dia', 'total', 'Meta diária', dashboard.target?.goal_value]].forEach(([item, label, tone, schedule, goal]) => { %>
      <article class="dashboard-card shift-kpi shift-kpi--<%= tone %>">
        <header class="dashboard-card__header"><h2><%= label %></h2><span class="dashboard-pill"><%= schedule %></span></header>
        <div class="shift-kpi__documents">
          <div><small>Com doc</small><strong><%= item.withDocRecords %></strong><b><%= brl(item.withDocRevenue) %></b></div>
          <div><small>Sem doc</small><strong><%= item.withoutDocRecords %></strong><b><%= brl(item.withoutDocRevenue) %></b></div>
        </div>
        <div class="shift-kpi__total"><small><%= tone === 'morning' ? 'Vendas da manhã' : tone === 'afternoon' ? 'Vendas da tarde' : 'Vendas totais do dia' %></small><strong><%= brl(item.revenue) %></strong></div>
        <div class="shift-kpi__goal shift-kpi__goal--<%= goalState(item.revenue, goal) %>"><small><%= tone === 'morning' ? 'Meta da manhã' : tone === 'afternoon' ? 'Meta da tarde' : 'Meta a bater' %></small><strong><%= target(goal) %></strong></div>
      </article>
    <% }) %>

    <article class="dashboard-card revenue-goals">
      <header class="dashboard-card__header"><h2>Metas de receita</h2></header>
      <div class="revenue-goals__list">
        <% [['portability_base', 'Portabilidade / Base', 'portability_base_value'], ['portability_out', 'Portabilidade / Fora da base', 'portability_out_value'], ['new_base', 'Novo / Base', 'new_base_value'], ['new_out', 'Novo / Fora da base', 'new_out_value']].forEach(([key, label, goalKey]) => { %>
          <div title="<%= label %>: <%= brl(dashboard.data.categories[key]) %> / <%= target(dashboard.target?.[goalKey]) %>"><span><%= label %></span><strong><%= brl(dashboard.data.categories[key]) %> <em>/ <%= target(dashboard.target?.[goalKey]) %></em></strong></div>
        <% }) %>
      </div>
    </article>

    <article class="dashboard-card operator-card">
      <header class="dashboard-card__header"><h2>Operadoras</h2><span class="dashboard-pill">Participação no dia</span></header>
      <% if (dashboard.data.operators.length) { %>
        <div class="operator-card__legend">
          <% dashboard.data.operators.forEach((operator) => { %>
            <div><i class="operator-dot operator-dot--<%= operator.code %>"></i><span title="<%= operator.name %>"><b><%= operator.name %></b><small>Qtd: <%= operator.units %><br><%= brl(operator.revenue) %></small></span></div>
          <% }) %>
        </div>
        <div class="operator-card__chart">
          <svg viewBox="0 0 42 42" role="img" aria-label="Distribuição da receita por operadora">
            <circle cx="21" cy="21" r="10" pathLength="100" fill="none" stroke="#242940" stroke-width="20"></circle>
            <% let operatorOffset = 0; dashboard.data.operators.forEach((operator) => { const share = operator.revenue / operatorTotal * 100; %>
              <circle class="operator-card__slice" tabindex="0" cx="21" cy="21" r="10" pathLength="100" fill="none" stroke="<%= operator.color %>" stroke-width="20" stroke-dasharray="<%= share %> <%= 100 - share %>" stroke-dashoffset="<%= -operatorOffset %>" transform="rotate(-90 21 21)" data-operator="<%= operator.code %>" data-name="<%= operator.name %>" data-quantity="<%= operator.units %>" data-value="<%= brl(operator.revenue) %>"><title><%= operator.name %> — Quantidade: <%= operator.units %> — Valor: <%= brl(operator.revenue) %></title></circle>
            <% operatorOffset += share; }) %>
            <% let labelOffset = 0; dashboard.data.operators.forEach((operator) => { const share = operator.revenue / operatorTotal * 100; const angle = (-90 + (labelOffset + share / 2) * 3.6) * Math.PI / 180; const labelX = 21 + Math.cos(angle) * 6.2; const labelY = 21 + Math.sin(angle) * 6.2; %>
              <text class="operator-card__percentage" x="<%= labelX.toFixed(2) %>" y="<%= labelY.toFixed(2) %>" text-anchor="middle" dominant-baseline="middle"><%= Math.round(share) %>%</text>
            <% labelOffset += share; }) %>
          </svg>
          <div class="operator-chart-tooltip" role="tooltip" hidden><strong></strong><span><i></i>Quantidade: <b></b></span><small>Valor: <b></b></small></div>
        </div>
      <% } else { %><div class="dashboard-empty">Nenhuma venda no período.</div><% } %>
    </article>

    <article class="dashboard-showcase">
      <div class="dashboard-showcase__trophy">
        <video class="dashboard-showcase__video" autoplay muted loop playsinline preload="metadata" aria-label="Troféu dourado de melhor vendedor"><source src="/assets/videos/trofeu.mp4" type="video/mp4"></video>

      </div>
      <div class="dashboard-showcase__leader">
        <% if (leader?.photo_media_id) { %><img src="/media/<%= leader.photo_media_id %>" alt="Foto de <%= leader.full_name %>"><% } else { %><span class="dashboard-showcase__placeholder"><%= leader?.full_name?.charAt(0) || '—' %></span><% } %>
        <div><strong><%= leader?.full_name || 'Sem ranking' %></strong><small><%= leader ? 'Tenta me passar, consegue?' : 'Aguardando vendas' %></small></div>
      </div>
    </article>
  </section>

  <section class="dashboard-card sales-results">
    <div class="sales-results__toolbar">
      <h2>Resultado de vendas</h2>
      <form method="get" class="sales-results__filters" id="dashboard-filters">
        <label>Período<select name="period" id="dashboard-period"><% [['today', 'Hoje'], ['morning', 'Manhã'], ['afternoon', 'Tarde'], ['week', 'Semana'], ['biweekly', 'Quinzena'], ['month', 'Mês'], ['custom', 'Personalizado']].forEach(([value, label]) => { %><option value="<%= value %>" <% if ((query.period || 'today') === value) { %>selected<% } %>><%= label %></option><% }) %></select></label>
        <label>Vendedora<select name="seller_id"><option value="">Todas</option><% refs.sellers.forEach((item) => { %><option value="<%= item.id %>" <% if (Number(query.seller_id) === Number(item.id)) { %>selected<% } %>><%= item.full_name %></option><% }) %></select></label>
        <label>Documento<select name="has_doc"><option value="">Todos</option><option value="true" <% if (query.has_doc === 'true') { %>selected<% } %>>Com doc</option><option value="false" <% if (query.has_doc === 'false') { %>selected<% } %>>Sem doc</option></select></label>
        <label>Base<select name="is_base_sale"><option value="">Todas</option><option value="true" <% if (query.is_base_sale === 'true') { %>selected<% } %>>Base</option><option value="false" <% if (query.is_base_sale === 'false') { %>selected<% } %>>Fora da base</option></select></label>
        <label>Operadora<select name="operator_id"><option value="">Todas</option><% refs.operators.forEach((item) => { %><option value="<%= item.id %>" <% if (Number(query.operator_id) === Number(item.id)) { %>selected<% } %>><%= item.name %></option><% }) %></select></label>
        <label>Serviço<select name="service_id"><option value="">Todos</option><% refs.services.forEach((item) => { %><option value="<%= item.id %>" <% if (Number(query.service_id) === Number(item.id)) { %>selected<% } %>><%= item.name %></option><% }) %></select></label>
        <label>Tipo da venda<select name="sale_type_id"><option value="">Todos</option><% refs.saleTypes.forEach((item) => { %><option value="<%= item.id %>" <% if (Number(query.sale_type_id) === Number(item.id)) { %>selected<% } %>><%= item.name %></option><% }) %></select></label>
        <label class="dashboard-custom-date" <% if ((query.period || 'today') !== 'custom') { %>hidden<% } %>>Início<input type="date" name="start_date" value="<%= query.start_date || '' %>"></label>
        <label class="dashboard-custom-date" <% if ((query.period || 'today') !== 'custom') { %>hidden<% } %>>Fim<input type="date" name="end_date" value="<%= query.end_date || '' %>"></label>
        <a href="/" class="dashboard-filter-button dashboard-filter-button--clear">Limpar</a><button type="submit" class="dashboard-filter-button">Aplicar</button>
      </form>
      <p class="sales-results__goal"><%= dashboard.range.shift === 'morning' ? 'Meta da manhã' : dashboard.range.shift === 'afternoon' ? 'Meta da tarde' : 'Meta do período' %>: <strong><%= target(dashboard.targetValue) %></strong></p>
    </div>
    <% if (dashboard.goalFilterWarning) { %><p class="dashboard-warning">O realizado está filtrado; a meta não é ajustada por estas dimensões.</p><% } %>
    <div class="ranking-scroll">
      <table class="sales-ranking">
        <colgroup><col class="sales-ranking__seller"><col><col class="sales-ranking__total"></colgroup>
        <thead><tr><th>Vendedora</th><th>Vendas</th><th>Total</th></tr></thead>
        <tbody>
          <% dashboard.data.ranking.forEach((row) => { %>
            <tr class="<%= row.position === 1 ? 'sales-ranking__leader' : '' %>">
              <td><div class="seller-cell"><span class="seller-rank"><% if (row.position === 1) { %><img src="/assets/img/crown.png" alt="1º lugar"><% } else { %>#<%= row.position %><% } %></span><strong><%= row.full_name %></strong></div></td>
              <td><div class="sale-chip-strip">
                <% row.sales.forEach((sale, saleIndex) => { %>
                  <% if (saleIndex) { %><span class="sale-chip-plus">+</span><% } %>
                  <span class="sale-chip" title="<%= sale.operator_name %> · <%= sale.service_name %> · <%= sale.sale_type_name %>">
                    <b><%= sale.quantity %> x <%= decimal(sale.unit_value) %></b>
                    <% if (sale.operator_icon_media_id) { %><img src="/media/<%= sale.operator_icon_media_id %>" alt="<%= sale.operator_name %>"><% } else { %><i class="sale-chip__fallback sale-chip__fallback--operator"><%= sale.operator_name.charAt(0) %></i><% } %>
                    <% if (sale.service_icon_media_id) { %><img src="/media/<%= sale.service_icon_media_id %>" alt="<%= sale.service_name %>"><% } else { %><i class="sale-chip__fallback"><%= sale.service_name.charAt(0) %></i><% } %>
                    <% if (sale.sale_type_icon_media_id) { %><img src="/media/<%= sale.sale_type_icon_media_id %>" alt="<%= sale.sale_type_name %>"><% } else { %><i class="sale-chip__fallback sale-chip__fallback--type"><%= sale.sale_type_name.charAt(0) %></i><% } %>
                    <img src="/assets/img/<%= sale.has_doc ? 'com_doc' : 'sem_doc' %>.png" alt="<%= sale.has_doc ? 'Com documento' : 'Sem documento' %>">
                    <img class="sale-chip__period" src="/assets/img/<%= sale.sale_shift === 'morning' ? 'manha' : 'tarde' %>.png" alt="<%= sale.sale_shift === 'morning' ? 'Manhã' : 'Tarde' %>" title="<%= sale.sale_shift === 'morning' ? 'Manhã' : 'Tarde' %>">
                    <em class="sale-origin sale-origin--<%= sale.is_base_sale ? 'base' : 'out' %>"><%= sale.is_base_sale ? 'Base' : 'Fora base' %></em>
                  </span>
                <% }) %>
              </div></td>
              <td><strong><%= brl(row.revenue) %></strong></td>
            </tr>
          <% }) %>
          <% if (!dashboard.data.ranking.length) { %><tr><td colspan="3"><div class="dashboard-empty">Nenhuma venda encontrada com estes filtros.</div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="sales-dashboard__bottom">
    <article class="dashboard-card period-countdown">
      <header class="dashboard-card__header"><h2>Períodos</h2><span class="dashboard-pill" id="business-period-pill">Agora</span></header>
      <div class="period-countdown__box" id="business-countdown" data-timezone="<%= timezone %>">
        <strong>Contagem regressiva</strong><b>--min --s</b><small>Calculando o próximo período comercial</small>
      </div>
    </article>
    <article class="dashboard-card dashboard-performance">
      <h2>Ticket médio, UGRs e Velocímetro da meta</h2>
      <div class="dashboard-performance__metrics"><span><small>UGR total</small><strong><%= dashboard.data.totals.units %></strong></span><span><small>Receita</small><strong><%= brl(dashboard.data.totals.revenue) %></strong></span><span><small>Ticket médio por unidade vendida</small><strong><%= brl(dashboard.data.totals.ticket) %></strong></span></div>
      <div class="dashboard-gauges">
        <% [['today', 'Diária'], ['week', 'Semanal'], ['biweekly', 'Quinzenal'], ['month', 'Mensal']].forEach(([key, label]) => { const gauge = dashboard.gauges[key]; const gaugePercent = Math.max(0, Math.min(100, gauge.percent || 0)); const needleAngle = -90 + gaugePercent * 1.8; %>
          <div class="dashboard-gauge dashboard-gauge--<%= key %>">
            <svg viewBox="0 0 120 67" role="img" aria-label="<%= label %>: <%= gauge.percent == null ? 'sem meta' : gauge.percent.toFixed(2) + '%' %>"><path class="dashboard-gauge__track" pathLength="100" d="M10 57 A50 50 0 0 1 110 57"></path><path class="dashboard-gauge__value" pathLength="100" stroke-dasharray="<%= gaugePercent %> <%= 100 - gaugePercent %>" d="M10 57 A50 50 0 0 1 110 57"></path><line class="dashboard-gauge__needle" x1="60" y1="57" x2="60" y2="24" transform="rotate(<%= needleAngle %> 60 57)"></line><circle class="dashboard-gauge__hub" cx="60" cy="57" r="5"></circle><text x="60" y="48" text-anchor="middle"><%= gauge.percent == null ? '0.00%' : gauge.percent.toFixed(2) + '%' %></text></svg>
            <strong><%= label %></strong><small>Meta: <%= target(gauge.target) %></small>
          </div>
        <% }) %>
      </div>
    </article>
  </section>
</section>
<script src="/assets/js/dashboard.js?v=20260724-3" defer></script>