<% const brl=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});const target=v=>v==null?'Sem meta':brl(v);const pct=(realized,value)=>value?Math.min(100,realized/Number(value)*100):0;const morning=dashboard.data.shifts.morning||{records:0,units:0,revenue:0,withDocRecords:0,withoutDocRecords:0};const afternoon=dashboard.data.shifts.afternoon||{records:0,units:0,revenue:0,withDocRecords:0,withoutDocRecords:0};const leader=dashboard.data.ranking[0];const opTotal=dashboard.data.operators.reduce((sum,item)=>sum+item.revenue,0)||1; %>
<header class="dashboard-header"><div><p class="eyebrow">Visão comercial</p><h1>Dashboard de Vendas</h1><p>Resultados de <%=dashboard.range.start%> a <%=dashboard.range.end%></p></div><div id="business-timer" class="business-timer" data-timezone="<%=timezone%>"><span>Período comercial</span><strong>--:--:--</strong><small>Carregando…</small></div></header>
<section class="dashboard-top-grid" aria-label="Resumo do período">
  <% [[morning,'Manhã','morning',dashboard.target?.morning_value],[afternoon,'Tarde','afternoon',dashboard.target?.afternoon_value],[dashboard.data.totals,'Total','total',dashboard.target?.goal_value]].forEach(([item,label,tone,goal])=>{%><article class="dash-card shift-card shift-card--<%=tone%>"><div class="dash-card-heading"><div><span class="icon-dot"></span><h2><%=label%></h2></div><span class="dark-pill"><%=item.records%> vendas</span></div><div class="doc-stats"><div><img src="/assets/img/doc.svg" alt=""><span>Com documento</span><strong><%=item.withDocRecords%></strong></div><div><img src="/assets/img/no-doc.svg" alt=""><span>Sem documento</span><strong><%=item.withoutDocRecords%></strong></div></div><div class="shift-total"><span>Resultado</span><strong><%=item.units%> <small>UGR</small></strong><b><%=brl(item.revenue)%></b></div><div class="goal-progress"><div><span>Meta</span><strong><%=target(goal)%></strong></div><meter min="0" max="100" value="<%=pct(item.revenue,goal)%>"><%=pct(item.revenue,goal)%>%</meter><span class="goal-status <%=goal==null?'neutral':item.revenue>=goal?'success':item.revenue>=goal*.9?'warning':'danger'%>"><%=goal==null?'Meta não cadastrada':pct(item.revenue,goal).toFixed(1)+'% alcançado'%></span></div></article><%})%>
  <article class="dash-card revenue-card"><div class="dash-card-heading"><div><span class="icon-dot"></span><h2>Faturamento</h2></div></div><div class="revenue-total"><span>Receita total</span><strong><%=brl(dashboard.data.totals.revenue)%></strong></div><div class="revenue-list"><%[['portability_base','Portabilidade · Base','portability_base_value'],['portability_out','Portabilidade · Fora','portability_out_value'],['new_base','Novo · Base','new_base_value'],['new_out','Novo · Fora','new_out_value']].forEach(([key,label,targetKey])=>{%><div><span><%=label%></span><strong><%=brl(dashboard.data.categories[key])%> <small>/ <%=target(dashboard.target?.[targetKey])%></small></strong></div><%})%></div></article>
  <article class="dash-card operators-card"><div class="dash-card-heading"><div><span class="icon-dot"></span><h2>Operadoras</h2></div></div><%if(dashboard.data.operators.length){%><div class="operator-chart"><svg viewBox="0 0 42 42" role="img" aria-label="Distribuição de faturamento por operadora"><circle cx="21" cy="21" r="15.9" fill="none" stroke="#222844" stroke-width="7"></circle><%let offset=25;dashboard.data.operators.forEach(op=>{const share=op.revenue/opTotal*100;%><circle cx="21" cy="21" r="15.9" fill="none" stroke="<%=op.color%>" stroke-width="7" stroke-dasharray="<%=share%> <%=100-share%>" stroke-dashoffset="<%=offset%>"></circle><%offset-=share;})%></svg><strong><%=dashboard.data.totals.units%><small>UGR</small></strong></div><ul class="operator-legend"><%dashboard.data.operators.forEach(op=>{%><li><i></i><span><%=op.name%></span><strong><%=op.units%> UGR</strong></li><%})%></ul><%}else{%><div class="dark-empty">Nenhuma venda no período.</div><%}%></article>
  <article class="dash-card showcase-card"><div class="showcase-side"><span class="showcase-label">Destaque do período</span><img class="trophy" src="/assets/img/crown.svg" alt="Troféu de destaque"><strong><%=dashboard.data.totals.units%> UGR</strong><small>Volume total vendido</small></div><div class="showcase-side leader"><span class="showcase-label">Liderança</span><%if(leader?.photo_media_id){%><img class="leader-photo" src="/media/<%=leader.photo_media_id%>" alt="Foto de <%=leader.full_name%>"><%}else{%><span class="leader-placeholder"><%=leader?.full_name?.charAt(0)||'—'%></span><%}%><strong><%=leader?.full_name||'Sem ranking'%></strong><small><%=leader?leader.units+' UGR · '+brl(leader.revenue):'Aguardando vendas'%></small></div></article>
</section>
<section class="dash-card results-card"><div class="results-heading"><div><p class="eyebrow">Detalhamento</p><h2>Resultado por vendedora</h2></div><button type="button" class="dark-button filter-toggle" aria-expanded="<%=Object.keys(query).length>0%>" aria-controls="dashboard-filters">Filtros</button><div class="result-summary"><span>Meta do período</span><strong><%=target(dashboard.target?.goal_value)%></strong></div></div>
  <form method="get" id="dashboard-filters" class="dashboard-filters <%=Object.keys(query).length?'is-open':''%>"><label>Período<select name="period"><%[['today','Hoje'],['week','Semana'],['biweekly','Quinzena'],['month','Mês'],['custom','Personalizado']].forEach(([v,l])=>{%><option value="<%=v%>" <%=(query.period||'today')===v?'selected':''%>><%=l%></option><%})%></select></label><%[['seller_id','Vendedora',refs.sellers,'full_name'],['operator_id','Operadora',refs.operators,'name'],['service_id','Serviço',refs.services,'name'],['sale_type_id','Tipo',refs.saleTypes,'name']].forEach(([field,label,items,name])=>{%><label><%=label%><select name="<%=field%>"><option value="">Todos</option><%items.forEach(item=>{%><option value="<%=item.id%>" <%=Number(query[field])===Number(item.id)?'selected':''%>><%=item[name]%></option><%})%></select></label><%})%><label>Documento<select name="has_doc"><option value="">Todos</option><option value="true" <%=query.has_doc==='true'?'selected':''%>>Com</option><option value="false" <%=query.has_doc==='false'?'selected':''%>>Sem</option></select></label><label>Origem<select name="is_base_sale"><option value="">Todas</option><option value="true" <%=query.is_base_sale==='true'?'selected':''%>>Base</option><option value="false" <%=query.is_base_sale==='false'?'selected':''%>>Fora</option></select></label><label class="custom-date">Início<input type="date" name="start_date" value="<%=query.start_date||''%>"></label><label class="custom-date">Fim<input type="date" name="end_date" value="<%=query.end_date||''%>"></label><button class="dark-button" type="submit">Aplicar</button></form>
  <%if(dashboard.goalFilterWarning){%><p class="dark-alert">O realizado está filtrado; a meta permanece integral.</p><%}%><div class="ranking-table"><div class="ranking-head"><span>Posição / Vendedora</span><span>Vendas</span><span>Total</span></div><%dashboard.data.ranking.forEach(row=>{%><div class="ranking-row"><div><span class="rank <%=row.position===1?'rank-first':''%>"><%=row.position%>º</span><%if(row.photo_media_id){%><img src="/media/<%=row.photo_media_id%>" alt=""><%}else{%><i><%=row.full_name.charAt(0)%></i><%}%><strong><%=row.full_name%></strong></div><div class="sales-chips"><span><%=row.units%> UGR</span><span><%=row.revenue?brl(row.revenue):'R$ 0,00'%></span></div><strong><%=brl(row.revenue)%></strong></div><%})%><%if(!dashboard.data.ranking.length){%><div class="dark-empty">Nenhuma venda encontrada com estes filtros.</div><%}%></div>
</section>
<section class="dashboard-bottom"><article class="dash-card period-card"><p class="eyebrow">Agora</p><h2>Período comercial</h2><div class="period-clock"><span>08:00</span><i></i><span>12:00</span><i></i><span>13:30</span><i></i><span>17:30</span></div><p>O relógio respeita o fuso comercial configurado.</p></article><article class="dash-card performance-card"><div><p class="eyebrow">Evolução</p><h2>Performance de metas</h2></div><div class="performance-metrics"><span><small>Receita</small><strong><%=brl(dashboard.data.totals.revenue)%></strong></span><span><small>Ticket / UGR</small><strong><%=brl(dashboard.data.totals.ticket)%></strong></span><span><small>Vendas</small><strong><%=dashboard.data.totals.records%></strong></span></div><div class="gauge-grid"><%[['today','Diária'],['week','Semanal'],['biweekly','Quinzenal'],['month','Mensal']].forEach(([key,label])=>{const gauge=dashboard.gauges[key];%><div class="gauge"><meter min="0" max="100" value="<%=Math.min(100,gauge.percent||0)%>"><%=gauge.percent||0%>%</meter><strong><%=gauge.percent==null?'—':gauge.percent.toFixed(0)+'%'%></strong><span><%=label%></span><small><%=brl(gauge.realized)%> / <%=target(gauge.target)%></small></div><%})%></div></article></section>
<script src="/assets/js/dashboard.js" defer></script>
