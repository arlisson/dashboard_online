<header class="page-header"><h1>Usuários</h1></header><section class="grid two"><div class="card"><h2>Novo usuário</h2><form method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome<input name="name" required maxlength="120"></label><label>E-mail<input type="email" name="email" required maxlength="191"></label><label>Papel<select name="role"><option value="viewer">Consulta</option><option value="operator">Operador</option><option value="admin">Administrador</option></select></label><label>Senha inicial<input type="password" name="password" minlength="12" required></label><button type="submit">Criar</button></form></div><div class="card table-wrap"><h2>Cadastrados</h2><table><thead><tr><th>Nome</th><th>E-mail</th><th>Papel</th><th>Status</th><th>Ação</th></tr></thead><tbody><% users.forEach((user) => { %><tr><form method="post" action="/users/<%= user.id %>"><td><input name="name" value="<%= user.name %>" required></td><td><%= user.email %></td><td><select name="role"><% ['viewer','operator','admin'].forEach((role) => { %><option value="<%= role %>" <%= user.role === role ? 'selected' : '' %>><%= role %></option><% }) %></select></td><td><select name="is_active"><option value="true" <%= user.is_active ? 'selected' : '' %>>Ativo</option><option value="false" <%= !user.is_active ? 'selected' : '' %>>Inativo</option></select></td><td><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Salvar</button></td></form></tr><% }) %></tbody></table></div></section>
