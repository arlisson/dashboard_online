<header class="page-header"><h1>Trocar senha</h1></header><section class="card narrow"><% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %><form method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Senha atual<input type="password" name="current_password" required autocomplete="current-password"></label><label>Nova senha<input type="password" name="new_password" minlength="12" required autocomplete="new-password"></label><button type="submit">Salvar senha</button></form></section>
