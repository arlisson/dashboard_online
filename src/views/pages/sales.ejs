<% const isForm = currentUser.role !== 'viewer' && (edit || query.tab === 'form'); const sale = (typeof draft !== 'undefined' && draft) || edit || {}; const errors = (typeof fieldErrors !== 'undefined' && fieldErrors) || {}; const hasFormError = typeof formError !== 'undefined' && formError; const selected = (value,current) => String(value) === String(current); %>
<header class="page-header"><div><h1>Vendas</h1><p>Cadastre, visualize e gerencie as vendas do sistema.</p></div></header>
<section class="admin-card management-hub sales-hub">
  <div class="tabs" role="tablist" aria-label="Seções de vendas"><a role="tab" aria-selected="<%= !isForm %>" tabindex="<%= !isForm ? 0 : -1 %>" class="tab <%= !isForm ? 'is-active' : '' %>" href="/sales">Lista de Vendas</a><% if(currentUser.role !== 'viewer'){%><a role="tab" aria-selected="<%= isForm %>" tabindex="<%= isForm ? 0 : -1 %>" class="tab <%= isForm ? 'is-active' : '' %>" href="/sales?tab=form"><%= edit ? 'Editar' : 'Cadastrar' %> Venda</a><%}%></div>
  <% if(isForm){%><section class="form-panel" role="tabpanel"><h2><%= edit ? 'Editar Venda' : 'Cadastrar Venda' %></h2><p>Preencha os dados para <%= edit ? 'atualizar a' : 'adicionar uma nova' %> venda.</p><% if(hasFormError){ %><div class="form-error" role="alert"><strong><%= hasFormError %></strong><% Object.values(errors).forEach((message)=>{ %><span><%= message %></span><% }) %></div><% } %>
    <form id="sale-form" method="post" action="<%= edit ? '/sales/' + edit.id : '/sales' %>" class="stack" data-mode="<%= edit ? 'edit' : 'create' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% [['seller_id','Vendedora',references.sellers,'full_name'],['service_id','Serviço',references.services,'name'],['operator_id','Operadora',references.operators,'name'],['sale_type_id','Tipo da Venda',references.sale_types,'name']].forEach(([field,label,items,name])=>{%><label><%=label%><select name="<%=field%>" required><option value="">Selecione</option><%items.forEach(item=>{%><option value="<%=item.id%>" <%=selected(item.id,sale[field])?'selected':''%>><%=item[name]%><%=item.is_active?'':' (inativo)'%></option><%})%></select></label><%})%>
      <label>Data da Venda<input id="sale-date" type="date" name="sale_date" required value="<%= sale.sale_date || now.date %>"></label><label>Horário da Venda<span class="input-action"><input id="sale-time" type="time" name="sale_time" required value="<%= sale.sale_time ? String(sale.sale_time).slice(0,5) : now.time %>"><button id="sale-now" class="button button-secondary" type="button">Agora</button></span></label>
      <label>CNPJ<input id="cnpj" name="cnpj" inputmode="numeric" value="<%=sale.cnpj_digits||sale.cnpj||''%>"></label><label>Razão Social<input name="company_name" maxlength="191" value="<%=sale.company_name||''%>"></label><label>Telefone de Contato<input name="phone" maxlength="30" value="<%=sale.phone||''%>"></label><label>Nome de Quem Fechou<input name="closed_by_name" maxlength="120" value="<%=sale.closed_by_name||''%>"></label>
      <label>Possui Documento?<select name="has_doc"><option value="false" <%=sale.id&&!sale.has_doc?'selected':''%>>Não</option><option value="true" <%=sale.has_doc?'selected':''%>>Sim</option></select></label><label>Origem do Cliente<select name="is_base_sale"><option value="false" <%=sale.id&&!sale.is_base_sale?'selected':''%>>Fora da base</option><option value="true" <%=sale.is_base_sale?'selected':''%>>Da base</option></select></label><label>Quantidade<input id="quantity" type="number" min="1" step="1" name="quantity" required value="<%=sale.quantity||1%>"></label><label>Valor Unitário<input id="unit-value" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" name="unit_value" required value="<%=sale.unit_value||''%>"></label><label>Valor Total<input id="total-value" readonly value="<%=sale.total_value||''%>"></label>
      <div class="form-actions"><a class="button button-secondary" href="/sales">Cancelar</a><button type="submit">Salvar</button></div>
    </form></section>
  <%}else{%><section role="tabpanel" class="list-panel"><div class="section-heading"><div><h2>Lista de Vendas</h2><p>Gerencie os registros cadastrados.</p></div><button class="button button-secondary filter-toggle" type="button" aria-expanded="<%=Object.keys(query).length>0%>" aria-controls="sales-filters">Mostrar filtros</button></div>
    <form id="sales-filters" method="get" class="filter-panel filter-panel--sales <%=Object.keys(query).length?'is-open':''%>"><label>Busca<input name="search" value="<%=query.search||''%>"></label><label>Início<input type="date" name="start_date" value="<%=query.start_date||''%>"></label><label>Fim<input type="date" name="end_date" value="<%=query.end_date||''%>"></label><label>Turno<select name="shift"><option value="">Todos</option><option value="morning" <%=query.shift==='morning'?'selected':''%>>Manhã</option><option value="afternoon" <%=query.shift==='afternoon'?'selected':''%>>Tarde</option></select></label><label>Documento<select name="has_doc"><option value="">Todos</option><option value="true" <%=query.has_doc==='true'?'selected':''%>>Com</option><option value="false" <%=query.has_doc==='false'?'selected':''%>>Sem</option></select></label><label>Origem<select name="is_base_sale"><option value="">Todas</option><option value="true" <%=query.is_base_sale==='true'?'selected':''%>>Base</option><option value="false" <%=query.is_base_sale==='false'?'selected':''%>>Fora</option></select></label><div class="filter-actions"><a class="button button-ghost" href="/sales">Limpar</a><button type="submit">Filtrar</button></div></form>
    <div class="table-scroll"><table class="data-table sales-table"><thead><tr><th>Vendedora</th><th>Serviço</th><th>Operadora</th><th>CNPJ</th><th>Razão Social</th><th>Contato</th><th>Fechou</th><th>Data</th><th>Horário</th><th>Turno</th><th>Doc</th><th>Origem</th><th>Qtd.</th><th>Unitário</th><th>Total</th><th>Ações</th></tr></thead><tbody><%result.items.forEach(item=>{%><tr><td><%=item.seller_name%></td><td><%=item.service_name%></td><td><%=item.operator_name%></td><td><%=item.cnpj_digits||'—'%></td><td><%=item.company_name||'—'%></td><td><%=item.phone||'—'%></td><td><%=item.closed_by_name||'—'%></td><td><%=item.sale_date%></td><td><%=String(item.sale_time).slice(0,5)%></td><td><span class="status-badge <%=item.sale_shift==='morning'?'shift-morning':'shift-afternoon'%>"><%=item.sale_shift==='morning'?'Manhã':'Tarde'%></span></td><td><span class="status-badge <%=item.has_doc?'has-doc':'no-doc'%>"><%=item.has_doc?'Com documento':'Sem documento'%></span></td><td><span class="status-badge <%=item.is_base_sale?'is-base':'out-base'%>"><%=item.is_base_sale?'Da base':'Fora da base'%></span></td><td><%=item.quantity%></td><td>R$ <%=item.unit_value%></td><td>R$ <%=item.total_value%></td><td><div class="row-actions"><%if(currentUser.role!=='viewer'){%><a class="button button-secondary" href="/sales/<%=item.id%>/edit">Editar</a><%}%><%if(currentUser.role==='admin'){%><form method="post" action="/sales/<%=item.id%>/delete" data-confirm="Excluir esta venda? Esta ação não pode ser desfeita."><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="button button-danger" type="submit">Excluir</button></form><%}%></div></td></tr><%})%></tbody></table></div><p class="pagination-summary">Página <%=result.pagination.page%> de <%=result.pagination.pages%> — <%=result.pagination.total%> vendas.</p>
  </section><%}%>
</section><script src="/assets/js/sale-form.js?v=20260724-2" defer></script>
