<% const isForm = currentUser.role === 'admin' && (query.tab === 'form' || edit); const singularLower = def.singular.toLowerCase(); %>
<header class="page-header"><div><h1><%= def.label %></h1><p>Cadastre, visualize e gerencie <%= key === 'sale-types' ? 'os tipos de venda' : 'as ' + def.label.toLowerCase() %> do sistema.</p></div></header>
<section class="admin-card management-hub">
  <div class="tabs" role="tablist" aria-label="Seções de <%= def.label %>">
    <a role="tab" aria-selected="<%= !isForm %>" tabindex="<%= !isForm ? 0 : -1 %>" class="tab <%= !isForm ? 'is-active' : '' %>" href="/<%= def.path %>">Lista de <%= def.label %></a>
    <% if (currentUser.role === 'admin') { %><a role="tab" aria-selected="<%= isForm %>" tabindex="<%= isForm ? 0 : -1 %>" class="tab <%= isForm ? 'is-active' : '' %>" href="/<%= def.path %>?tab=form"><%= edit ? 'Editar' : 'Cadastrar' %> <%= def.singular %></a><% } %>
  </div>
  <% if (isForm) { const item = edit || {}; %>
  <section class="form-panel" role="tabpanel">
    <h2><%= edit ? 'Editar' : 'Cadastrar' %> <%= def.singular %></h2><p>Preencha os dados para <%= edit ? 'atualizar' : 'adicionar' %> <%= edit ? 'a' : 'uma nova' %> <%= singularLower %>.</p>
    <form method="post" action="/<%= def.path %><%= edit ? '/' + edit.id : '' %>" enctype="multipart/form-data" class="stack multipart-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Nome <%= key === 'sellers' ? 'da Vendedora' : key === 'sale-types' ? 'do Tipo de Venda' : 'd' + (key === 'services' ? 'o Serviço' : 'a Operadora') %><input name="<%= def.nameColumn %>" value="<%= item[def.nameColumn] || '' %>" placeholder="Digite o nome <%= key === 'sellers' ? 'da vendedora' : 'do cadastro' %>" required maxlength="120"></label>
      <% if (edit) { %><label>Status<select name="is_active"><option value="true" <%= item.is_active ? 'selected' : '' %>>Ativo</option><option value="false" <%= !item.is_active ? 'selected' : '' %>>Inativo</option></select></label><% } else { %><input type="hidden" name="is_active" value="true"><% } %>
      <label><%= key === 'sellers' ? 'Foto da Vendedora' : 'Ícone d' + (key === 'services' ? 'o Serviço' : key === 'operators' ? 'a Operadora' : 'o Tipo de Venda') %><input type="file" name="image" accept="image/png,image/jpeg,image/webp"></label>
      <% if (key !== 'sellers') { %><small>Formatos aceitos: JPG, PNG ou WEBP.</small><% } %>
      <% if (edit && item[def.mediaColumn]) { %><label class="check-label"><input type="checkbox" name="<%= key === 'sellers' ? 'remove_photo' : 'remove_icon' %>" value="true"> Remover imagem atual</label><% } %>
      <div class="form-actions"><a class="button button-secondary" href="/<%= def.path %>">Cancelar</a><button class="button button-primary" type="submit">Salvar</button></div>
    </form>
  </section>
  <% } else { %>
  <section role="tabpanel" class="list-panel">
    <div class="section-heading"><div><h2><%= key === 'sale-types' ? 'Tipos de Venda Cadastrados' : 'Lista de ' + def.label %></h2><p>Gerencie os registros cadastrados.</p></div><button class="button button-secondary filter-toggle" type="button" aria-expanded="<%= Object.keys(query).length > 0 %>" aria-controls="catalog-filters">Mostrar filtros</button></div>
    <form id="catalog-filters" method="get" class="filter-panel <%= Object.keys(query).length ? 'is-open' : '' %>"><label>Busca<input name="search" value="<%= query.search || '' %>"></label><label>Status<select name="status"><option value="">Todos</option><option value="active" <%= query.status === 'active' ? 'selected' : '' %>>Ativos</option><option value="inactive" <%= query.status === 'inactive' ? 'selected' : '' %>>Inativos</option></select></label><div class="filter-actions"><a class="button button-ghost" href="/<%= def.path %>">Limpar</a><button type="submit">Filtrar</button></div></form>
    <div class="table-scroll"><table class="data-table catalog-table"><thead><tr><% if (key !== 'sale-types') { %><th>ID</th><% } %><th><%= key === 'sellers' ? 'Foto' : 'Ícone' %></th><th><%= key === 'sellers' ? 'Nome da Vendedora' : key === 'sale-types' ? 'Tipo' : 'Nome d' + (key === 'services' ? 'o Serviço' : 'a Operadora') %></th><th>Status</th><% if (key !== 'sale-types') { %><th>Data de Criação</th><% } %><% if (currentUser.role === 'admin') { %><th>Ações</th><% } %></tr></thead><tbody>
      <% result.items.forEach((item) => { const mediaId = item[def.mediaColumn]; %><tr><% if (key !== 'sale-types') { %><td><%= item.id %></td><% } %><td><span class="thumb-box"><% if (mediaId) { %><img class="thumb" src="/media/<%= mediaId %>" alt=""><% } else { %><span aria-hidden="true"><%= item[def.nameColumn].charAt(0).toUpperCase() %></span><% } %></span></td><td><%= item[def.nameColumn] %></td><td><span class="status-badge <%= item.is_active ? 'status-active' : 'status-inactive' %>"><%= item.is_active ? 'Ativo' : 'Inativo' %></span></td><% if (key !== 'sale-types') { %><td><%= item.created_at ? new Date(item.created_at).toLocaleString('pt-BR') : '—' %></td><% } %><% if (currentUser.role === 'admin') { %><td><div class="row-actions"><a class="button button-secondary" href="/<%= def.path %>?tab=form&amp;edit=<%= item.id %>">Editar</a><form method="post" action="/<%= def.path %>/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="<%= def.nameColumn %>" value="<%= item[def.nameColumn] %>"><input type="hidden" name="is_active" value="<%= !item.is_active %>"><button class="button <%= item.is_active ? 'button-warning' : 'button-success' %>" type="submit"><%= item.is_active ? 'Inativar' : 'Ativar' %></button></form><form method="post" action="/<%= def.path %>/<%= item.id %>/delete" data-confirm="Excluir este registro? Quando houver vínculos, ele será apenas inativado."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger" type="submit">Excluir</button></form></div></td><% } %></tr><% }) %>
      <% if (!result.items.length) { %><tr><td colspan="7" class="empty-cell">Nenhum registro encontrado.</td></tr><% } %>
    </tbody></table></div><p class="pagination-summary">Página <%= result.pagination.page %> de <%= result.pagination.pages %> — <%= result.pagination.total %> registros.</p>
  </section><% } %>
</section>
