<header class="page-header"><h1>Integrações</h1><p>Crie e revogue as chaves usadas por sistemas externos para lançar vendas.</p></header>
<% if (createdKey) { %><section class="card form-panel"><h2>Copie a nova chave agora</h2><p class="alert alert-warning">Ela não será exibida novamente. Guarde-a no gerenciador de segredos do CRM.</p><label>Chave de API<input value="<%= createdKey %>" readonly></label></section><% } %>
<section class="grid two"><div class="card form-panel"><h2>Nova chave</h2><form method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome da integração<input name="name" required minlength="2" maxlength="120" placeholder="CRM comercial"></label><small>Esta chave permite somente consultar referências e criar vendas.</small><button type="submit">Criar chave</button></form></div><div class="card form-panel table-wrap"><h2>Chaves cadastradas</h2><table class="data-table"><thead><tr><th>Nome</th><th>Prefixo</th><th>Status</th><th>Último uso</th><th>Ação</th></tr></thead><tbody><% if (!keys.length) { %><tr><td colspan="5" class="empty-cell">Nenhuma chave cadastrada.</td></tr><% } %><% keys.forEach((key) => { %><tr><td><%= key.name %><br><small>Criada por <%= key.created_by_name || 'usuário removido' %></small></td><td><code>dav_live_<%= key.key_prefix %>_…</code></td><td><span class="status-badge <%= key.is_active ? 'status-active' : 'status-inactive' %>"><%= key.is_active ? 'Ativa' : 'Revogada' %></span></td><td><%= key.last_used_at ? new Date(key.last_used_at).toLocaleString('pt-BR') : 'Nunca' %></td><td><% if (key.is_active) { %><form method="post" action="/integrations/<%= key.id %>/revoke" onsubmit="return confirm('Revogar esta chave? O CRM deixará de acessar a integração.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-danger" type="submit">Revogar</button></form><% } else { %><small>Revogada</small><% } %></td></tr><% }) %></tbody></table></div></section>
