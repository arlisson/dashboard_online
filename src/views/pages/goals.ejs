<% const isForm=currentUser.role==='admin'&&(edit||query.tab==='form');const goal=edit||{}; %>
<header class="page-header"><div><h1>Metas</h1><p>Cadastre, visualize e gerencie as metas do sistema.</p></div></header>
<section class="admin-card management-hub"><div class="tabs" role="tablist" aria-label="Seções de metas"><a role="tab" aria-selected="<%=!isForm%>" tabindex="<%=!isForm?0:-1%>" class="tab <%=!isForm?'is-active':''%>" href="/goals">Lista de Metas</a><%if(currentUser.role==='admin'){%><a role="tab" aria-selected="<%=isForm%>" tabindex="<%=isForm?0:-1%>" class="tab <%=isForm?'is-active':''%>" href="/goals?tab=form"><%=edit?'Editar':'Cadastrar'%> Meta</a><%}%></div>
<%if(isForm){%><section class="form-panel"><h2><%=edit?'Editar Meta':'Cadastrar Meta'%></h2><p>Preencha os dados para <%=edit?'atualizar a':'cadastrar uma nova'%> meta.</p><form method="post" action="<%=edit?'/goals/'+edit.id:'/goals'%>" class="stack" id="goal-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>">
  <label>Tipo da Meta<select name="goal_type"><option value="general" <%=goal.goal_type!=='individual'?'selected':''%>>Geral</option><option value="individual" <%=goal.goal_type==='individual'?'selected':''%>>Individual</option></select></label><label>Período<select name="goal_period_id" required><option value="">Selecione</option><%refs.periods.forEach(p=>{%><option value="<%=p.id%>" data-code="<%=p.code%>" <%=Number(goal.goal_period_id)===Number(p.id)?'selected':''%>><%=p.name%></option><%})%></select></label><label class="seller-goal-field">Vendedora<select name="seller_id"><option value="">Selecione</option><%refs.sellers.forEach(s=>{%><option value="<%=s.id%>" <%=Number(goal.seller_id)===Number(s.id)?'selected':''%>><%=s.full_name%><%=s.is_active?'':' (inativa)'%></option><%})%></select></label>
  <div class="daily-goal-fields"><label>Meta da Manhã<input name="morning_value" inputmode="decimal" value="<%=goal.morning_value??''%>"></label><label>Meta da Tarde<input name="afternoon_value" inputmode="decimal" value="<%=goal.afternoon_value??''%>"></label></div>
  <label>Meta de Receita - Portabilidade / Base<input name="portability_base_value" inputmode="decimal" value="<%=goal.portability_base_value??''%>"></label><label>Meta de Receita - Portabilidade / Fora da Base<input name="portability_out_value" inputmode="decimal" value="<%=goal.portability_out_value??''%>"></label><label>Meta de Receita - Novo / Base<input name="new_base_value" inputmode="decimal" value="<%=goal.new_base_value??''%>"></label><label>Meta de Receita - Novo / Fora da Base<input name="new_out_value" inputmode="decimal" value="<%=goal.new_out_value??''%>"></label><small>Valores em R$; informe o faturamento desejado, não a quantidade de vendas.</small><label>Meta Total<input name="goal_value" inputmode="decimal" value="<%=goal.goal_value||''%>" required></label><label>Data Inicial<input type="date" name="start_date" value="<%=goal.start_date||''%>" required></label><label>Data Final<input type="date" name="end_date" value="<%=goal.end_date||''%>" required></label><div class="form-actions"><a class="button button-secondary" href="/goals">Cancelar</a><button type="submit">Salvar</button></div>
</form></section><%}else{%><section class="list-panel"><div class="section-heading"><div><h2>Lista de Metas</h2><p>Gerencie os registros cadastrados.</p></div><button class="button button-secondary filter-toggle" type="button" aria-expanded="<%=Object.keys(query).length>0%>" aria-controls="goal-filters">Mostrar filtros</button></div><form id="goal-filters" method="get" class="filter-panel <%=Object.keys(query).length?'is-open':''%>"><label>Tipo<select name="goal_type"><option value="">Todos</option><option value="general">Geral</option><option value="individual">Individual</option></select></label><label>Início<input type="date" name="start_date" value="<%=query.start_date||''%>"></label><label>Fim<input type="date" name="end_date" value="<%=query.end_date||''%>"></label><div class="filter-actions"><a class="button button-ghost" href="/goals">Limpar</a><button type="submit">Filtrar</button></div></form><div class="table-scroll"><table class="data-table"><thead><tr><th>ID</th><th>Tipo</th><th>Período</th><th>Vendedora</th><th>Valor</th><th>Início</th><th>Fim</th><th>Ações</th></tr></thead><tbody><%result.items.forEach(g=>{%><tr><td><%=g.id%></td><td><%=g.goal_type==='general'?'Geral':'Individual'%></td><td><%=g.period_name%></td><td><%=g.seller_name||'—'%></td><td>R$ <%=g.goal_value%></td><td><%=g.start_date%></td><td><%=g.end_date%></td><td><div class="row-actions"><%if(currentUser.role==='admin'){%><a class="button button-secondary" href="/goals/<%=g.id%>/edit">Editar</a><form method="post" action="/goals/<%=g.id%>/delete" data-confirm="Excluir esta meta?"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="button button-danger" type="submit">Excluir</button></form><%}%></div></td></tr><%})%></tbody></table></div><p class="pagination-summary">Página <%=result.pagination.page%> de <%=result.pagination.pages%>.</p></section><%}%></section>
